{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { 
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate" 
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*", 
      "destination": "https://capstone-mod6-general-trivia-app-1.onrender.com/api/:path*" 
    },
    {
       "source": "/(.*)",
       "destination": "/index.html" 
      }
  ]
}