# Copy this file to .env (same folder) and fill in your own values:
#   cp .env.example .env
# Never commit .env: it holds passwords and the JWT secret.

# Your local PostgreSQL database.
# Must start with postgresql+psycopg2:// (postgresql:// is converted automatically).
# Use letters and numbers only in the password: @ # / : break the URL.
DATABASE_URL=postgresql+psycopg2://trivia_user:your_password@localhost:5432/trivia_dev

# Signs login tokens. Generate your own with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<long random string>

# Optional: password for the demo user created by `python -m utils.seed`.
SEED_DEMO_PASSWORD=

# Optional (Phase 3): the admin account created by `flask --app app create-admin`.
# All three are needed. An existing account is never promoted.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
